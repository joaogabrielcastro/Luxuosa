{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": false,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/shared/**/*.js"],
  "exclude": ["node_modules", "src/shared/**/*.test.js"]
}
