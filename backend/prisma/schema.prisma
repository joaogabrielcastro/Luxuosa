generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

enum UserType {
  ADMIN
  ATTENDANT
}

enum StockMovementType {
  ENTRY
  EXIT
}

enum SaleStatus {
  OPEN
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  INSTALLMENT
}

enum InvoiceStatus {
  PENDING
  ISSUED
  ERROR
  CANCELED
}

enum NfceIssueJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CreditSaleStatus {
  OPEN
  PAID
  CANCELED
}

enum NfeImportStatus {
  DRAFT
  COMPLETED
  FAILED
}

enum NfeImportItemAction {
  LINKED
  CREATED
  IGNORED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Tenant {
  id               String   @id @default(cuid())
  name             String
  cnpj             String   @unique
  email            String
  phone            String?
  plan             Plan     @default(BASIC)
  /** Lojas legadas: nao aplica bloqueio por plano (NFC-e, import NF-e, alertas). Novos cadastros ficam false. */
  planGateExempt   Boolean  @default(false)
  /** Emissao NFC-e (Nuvem Fiscal). So habilite na loja com CNPJ/config na Nuvem — evita emitir pelo emitente errado. */
  enableNfceEmission Boolean @default(false)
  /** Customer Stripe (cus_...). */
  stripeCustomerId String?  @unique
  /** Subscription Stripe ativa/mais recente (sub_...). */
  stripeSubscriptionId String? @unique
  /** active | trialing | past_due | canceled | unpaid | incomplete | ... */
  stripeSubscriptionStatus String?
  /** Fim do periodo atual da assinatura (UTC). */
  planPeriodEnd    DateTime?
  /** Alertas de estoque baixo (email / WhatsApp). */
  stockAlertsEnabled     Boolean @default(false)
  stockAlertEmail        String?
  stockAlertPhone        String?
  /** low | critical — severidade minima para disparar. */
  stockAlertMinSeverity  String  @default("low")
  /** Cooldown em minutos entre alertas do mesmo produto. */
  stockAlertCooldownMin  Int     @default(1440)
  createdAt        DateTime @default(now())

  users       User[]
  customers   Customer[]
  categories  Category[]
  brands      Brand[]
  products    Product[]
  variations  ProductVariation[]
  stockMoves  StockMovement[]
  sales       Sale[]
  saleItems   SaleItem[]
  invoices    Invoice[]
  nfceJobs       NfceIssueJob[]
  creditSales    CreditSale[]
  creditSaleItems CreditSaleItem[]
  creditPayments CreditPayment[]
  suppliers      Supplier[]
  productSupplierCodes ProductSupplierCode[]
  nfeImports     NfeImport[]
  nfeImportItems NfeImportItem[]
  cashSessions   CashSession[]
  stockAlertLogs StockAlertLog[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  password  String
  type      UserType
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  creditSales CreditSale[]
  nfeImports NfeImport[]
  cashSessionsOpened CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashSessionClosedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  cpfCnpj         String?
  phone           String?
  email           String?
  address         String?
  uf              String?
  cep             String?
  ibgeMunicipio   String?
  municipioNome   String?
  totalPurchases  Decimal  @default(0) @db.Decimal(12, 2)
  lastPurchaseAt  DateTime?
  createdAt       DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  sales          Sale[]
  creditSales    CreditSale[]

  @@index([tenantId])
  @@index([tenantId, cpfCnpj])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  categoryId    String
  brandId       String
  sku           String?
  minStock      Int
  ncm           String   @default("61091000")
  cfop          String   @default("5102")
  icmsOrig      Int      @default(0)
  icmsCsosn     String   @default("102")
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  category      Category @relation(fields: [categoryId], references: [id])
  brand         Brand    @relation(fields: [brandId], references: [id])
  variations    ProductVariation[]
  supplierCodes ProductSupplierCode[]
  nfeImportItems NfeImportItem[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@unique([tenantId, sku])
}

model ProductVariation {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  size          String
  color         String
  stock         Int
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  stockMoves    StockMovement[]
  saleItems     SaleItem[]
  creditSaleItems CreditSaleItem[]
  nfeImportItems NfeImportItem[]

  @@index([tenantId])
  @@index([tenantId, productId])
  @@unique([tenantId, productId, size, color])
}

model StockMovement {
  id                 String            @id @default(cuid())
  tenantId           String
  productVariationId String
  type               StockMovementType
  quantity           Int
  occurredAt         DateTime          @default(now())
  nfeImportId        String?

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  productVariation   ProductVariation  @relation(fields: [productVariationId], references: [id])
  nfeImport          NfeImport?        @relation(fields: [nfeImportId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productVariationId])
  @@index([tenantId, nfeImportId])
}

model Supplier {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  tradeName          String?
  cnpj               String
  stateRegistration  String?
  createdAt          DateTime @default(now())

  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  productCodes       ProductSupplierCode[]
  nfeImports         NfeImport[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
}

model ProductSupplierCode {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  supplierId String
  code       String
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@unique([tenantId, supplierId, code])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model NfeImport {
  id            String          @id @default(cuid())
  tenantId      String
  accessKey     String
  number        String
  series        String
  issuedAt      DateTime
  importedAt    DateTime        @default(now())
  supplierId    String?
  supplierCnpj  String
  supplierName  String
  totalValue    Decimal         @db.Decimal(12, 2)
  paymentInfo   String?
  itemCount     Int
  status        NfeImportStatus @default(COMPLETED)
  userId        String

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  items         NfeImportItem[]
  stockMoves    StockMovement[]

  @@unique([tenantId, accessKey])
  @@index([tenantId])
  @@index([tenantId, importedAt])
  @@index([tenantId, supplierId])
}

model NfeImportItem {
  id                 String              @id @default(cuid())
  tenantId           String
  nfeImportId        String
  lineNumber         Int
  supplierCode       String?
  ean                String?
  description        String
  ncm                String?
  cfop               String?
  unit               String?
  quantity           Decimal             @db.Decimal(12, 4)
  quantityEntered    Int
  unitValue          Decimal             @db.Decimal(12, 4)
  totalValue         Decimal             @db.Decimal(12, 2)
  productId          String?
  productVariationId String?
  stockMovementId    String?
  action             NfeImportItemAction

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  nfeImport          NfeImport           @relation(fields: [nfeImportId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id])
  productVariation   ProductVariation?   @relation(fields: [productVariationId], references: [id])

  @@index([tenantId])
  @@index([tenantId, nfeImportId])
}

model Sale {
  id                 String        @id @default(cuid())
  tenantId           String
  customerId         String?
  userId             String
  totalValue         Decimal       @db.Decimal(12, 2)
  discountValue      Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent    Decimal       @default(0) @db.Decimal(5, 2)
  paymentMethod      PaymentMethod
  installments       Int           @default(1)
  status             SaleStatus    @default(PAID)
  occurredAt         DateTime      @default(now())

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  items              SaleItem[]
  invoice            Invoice?

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, occurredAt])
}

model SaleItem {
  id                 String            @id @default(cuid())
  tenantId           String
  saleId             String
  productVariationId String
  quantity           Int
  unitPrice          Decimal           @db.Decimal(12, 2)

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  sale               Sale              @relation(fields: [saleId], references: [id])
  productVariation   ProductVariation  @relation(fields: [productVariationId], references: [id])

  @@index([tenantId])
  @@index([tenantId, saleId])
}

model Invoice {
  id                  String        @id @default(cuid())
  tenantId            String
  saleId              String        @unique
  externalId          String?       @unique
  number              String?
  key                 String?
  status              InvoiceStatus @default(PENDING)
  xmlUrl              String?
  pdfUrl              String?
  lastError           String?       @db.Text
  issuedAt            DateTime?
  /** Evita emissao concorrente (HTTP + worker / duplo clique). TTL em codigo (lease). */
  emissionStartedAt   DateTime?

  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  sale                Sale          @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

model NfceIssueJob {
  id        String             @id @default(cuid())
  tenantId  String
  saleId    String             @unique
  status    NfceIssueJobStatus @default(PENDING)
  attempts  Int                @default(0)
  /** Quando definido, o worker so processa apos esta data (backoff). */
  runAt     DateTime?
  lastError String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, runAt])
}

model CreditSale {
  id              String           @id @default(cuid())
  tenantId        String
  customerId      String
  userId          String
  totalValue      Decimal          @db.Decimal(12, 2)
  discountValue   Decimal          @default(0) @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  paidTotal       Decimal          @default(0) @db.Decimal(12, 2)
  status          CreditSaleStatus @default(OPEN)
  notes           String?
  occurredAt      DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  items    CreditSaleItem[]
  payments CreditPayment[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, status])
}

model CreditSaleItem {
  id                 String           @id @default(cuid())
  tenantId           String
  creditSaleId       String
  productVariationId String
  quantity           Int
  unitPrice          Decimal          @db.Decimal(12, 2)

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  creditSale         CreditSale       @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)
  productVariation   ProductVariation @relation(fields: [productVariationId], references: [id])

  @@index([tenantId])
  @@index([tenantId, creditSaleId])
}

model CreditPayment {
  id             String          @id @default(cuid())
  tenantId       String
  creditSaleId   String
  amount         Decimal         @db.Decimal(12, 2)
  paymentMethod  PaymentMethod   @default(CASH)
  paidAt         DateTime        @default(now())
  note           String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  creditSale     CreditSale      @relation(fields: [creditSaleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, creditSaleId])
}

model CashSession {
  id             String            @id @default(cuid())
  tenantId       String
  openedByUserId String
  closedByUserId String?
  status         CashSessionStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingFloat   Decimal           @default(0) @db.Decimal(12, 2)
  expectedCash   Decimal?          @db.Decimal(12, 2)
  countedCash    Decimal?          @db.Decimal(12, 2)
  differenceCash Decimal?          @db.Decimal(12, 2)
  totalsByMethod Json?
  saleCount      Int?
  totalAmount    Decimal?          @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime          @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  openedBy User   @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedBy User?  @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
}

model StockAlertLog {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String
  productId String?
  severity  String
  status    String
  message   String?
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, productId, channel])
}
